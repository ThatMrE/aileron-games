---
import Base from '../layouts/Base.astro';
// Policy text ported from https://halos.bio/privacy (October 2026). Only
// "Information We Collect" (to list what the waitlist and partner forms on
// this site actually collect) and the last updated date are new; everything
// else is verbatim. Update the date whenever the policy text changes.
---
<Base title="Privacy Policy | HALOS" description="How HALOS Biosciences collects, uses and protects the information you share with us." home={false}>
  <article class="container legal">
    <a class="legal__back label" href="/">← Back to home</a>
    <h1>Privacy Policy</h1>
    <p class="legal__updated">Last updated <time datetime="2026-10-24">October 24, 2026</time></p>
    <section>
      <h2>Introduction</h2>
      <p>HALOS Bio respects your privacy and is committed to protecting your personal information. This Privacy Policy explains how we collect, use, and safeguard your information when you visit our website.</p>
    </section>
    <section>
      <h2>Information We Collect</h2>
      <p>When you join our waitlist, we collect:</p>
      <ul>
        <li>Your name</li>
        <li>Your email address</li>
        <li>Your role (for example researcher, clinician or investor)</li>
        <li>What you would use our product for (if provided)</li>
        <li>Date and time of submission</li>
      </ul>
      <p>When you contact us to partner or invest, we collect:</p>
      <ul>
        <li>Your name</li>
        <li>Your email address</li>
        <li>Your organization</li>
        <li>Your message</li>
        <li>Date and time of submission</li>
      </ul>
      <p>Form submissions are received and stored by our website hosting provider, Netlify, Inc., on our behalf.</p>
    </section>
    <section>
      <h2>How We Use Your Information</h2>
      <p>We use your information to:</p>
      <ul>
        <li>Send you research updates and company news</li>
        <li>Notify you when products or services become available</li>
        <li>Respond to your inquiries</li>
        <li>Improve our services</li>
      </ul>
    </section>
    <section>
      <h2>Data Protection</h2>
      <p>We implement appropriate security measures to protect your personal information from unauthorized access, alteration, disclosure, or destruction.</p>
    </section>
    <section>
      <h2>Your Rights</h2>
      <p>You have the right to:</p>
      <ul>
        <li>Access your personal data</li>
        <li>Request correction of your data</li>
        <li>Request deletion of your data</li>
        <li>Opt-out of communications at any time</li>
      </ul>
    </section>
  </article>
</Base>

<style>
  .legal { max-width: 820px; padding-block: 160px 120px; display: grid; gap: 40px; }
  .legal__back { text-decoration: none; color: var(--halo-indigo); }
  .legal__updated { margin-top: -24px; font-size: var(--step--1); color: var(--ink-soft); }
  .legal h1 { font-size: clamp(2.75rem, 2rem + 3vw, var(--step-5)); line-height: 1.1; }
  .legal section { display: grid; gap: 14px; }
  .legal h2 { font-size: var(--step-2); line-height: 1.2; }
  .legal ul { padding-left: 1.2em; display: grid; gap: 6px; }
</style>
