---
// Wraps an image in a ring or arch mask. The motion layer animates
// clip-path and the image scale; without it the mask is simply open.
interface Props { shape: 'ring' | 'arch'; class?: string; ratio?: string; spin?: boolean }
const { shape, class: cls, ratio, spin } = Astro.props;
---
<div class:list={['mask', `mask--${shape}`, cls]} data-mask={shape} data-mask-spin={spin ? '' : undefined} style={ratio ? `aspect-ratio:${ratio}` : undefined}>
  <div class="mask__media"><slot /></div>
  <slot name="overlay" />
</div>

<style>
  .mask { position: relative; overflow: hidden; }
  .mask--ring { border-radius: 50%; aspect-ratio: 1; }
  .mask--arch {
    aspect-ratio: 4 / 5;
    border-radius: 50% 50% var(--radius-card) var(--radius-card) / 40% 40% var(--radius-card) var(--radius-card);
  }
  .mask__media { position: absolute; inset: 0; }
  .mask__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
