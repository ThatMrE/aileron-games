---
// The hero's living object. The static ring below is the fallback and the
// reduced-motion state; the three.js scene mounts over it once it loads.
---
<div class="halo" data-halo aria-hidden="true">
  <div class="halo__glow"></div>
  <svg class="halo__static" viewBox="-40 -30 266 300" focusable="false">
    <defs>
      <linearGradient id="halo-static-grad" x1="0" y1="0" x2="186" y2="0" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#96B8FF" />
        <stop offset="1" stop-color="#E793FE" />
      </linearGradient>
    </defs>
    <circle cx="93" cy="93" r="81.5" fill="none" stroke="url(#halo-static-grad)" stroke-width="23" />
    <rect x="0" y="204" width="186" height="24" fill="url(#halo-static-grad)" />
  </svg>
</div>

<style>
  .halo { position: relative; width: 100%; height: 100%; display: grid; place-items: center; }
  .halo__static { position: relative; width: min(64%, 420px); height: auto; }
  /* Soft opal glow behind the ring; the symbol itself is never glowed. */
  .halo__glow {
    position: absolute;
    width: min(80%, 560px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--grad-opal);
    background-size: 300% 300%;
    filter: blur(48px);
    opacity: 0.75;
  }
</style>
