---
// Figure 3: the CulNet principle, redrawn as SVG from IntegriCulture's
// illustration (same layout) in the brand palette so it stays sharp at full
// width and can move: beads of medium flow through the tubes chamber to
// chamber, liquid surfaces ripple, tissues breathe and bubbles rise.
// Coordinates follow the original 910 x 540 artwork.

interface Vessel {
  id: string;
  x: number;      // body left
  lid: number;    // lid top
  w: number;      // body width
  body: number;   // body height
  lidH: number;
  ports: [number, number];
  portH: number;
  level: number;  // liquid surface as a share of body height from the top
}
const vessels: Vessel[] = [
  { id: 'a', x: 22, lid: 338, w: 112, body: 140, lidH: 22, ports: [55, 97], portH: 30, level: 0.62 },
  { id: 'b', x: 186, lid: 233, w: 110, body: 130, lidH: 22, ports: [218, 260], portH: 30, level: 0.62 },
  { id: 'c', x: 350, lid: 338, w: 112, body: 130, lidH: 22, ports: [382, 424], portH: 30, level: 0.62 },
  { id: 'd', x: 598, lid: 195, w: 182, body: 227, lidH: 48, ports: [655, 725], portH: 52, level: 0.66 },
];
const wave = (x: number, w: number, y: number) => {
  // A wave twice as wide as needed, so sliding it one period loops seamlessly.
  const period = 40;
  let d = `M${x - period * 2} ${y}`;
  for (let px = x - period * 2; px < x + w + period * 2; px += period) {
    d += ` q${period / 4} -3 ${period / 2} 0 t${period / 2} 0`;
  }
  return `${d} V${y + 400} H${x - period * 2} Z`;
};

// Tubes, in the direction the medium flows: chamber to chamber, through the
// collection vessel and its reservoir, then back to the first chamber.
const tubes = [
  { id: 't2', d: 'M97 310 C97 228 112 172 152 170 C196 168 218 184 218 205' },
  { id: 't3', d: 'M260 205 C262 172 292 164 322 169 C366 178 382 250 382 310' },
  { id: 't4', d: 'M424 310 C420 228 442 180 482 182 C542 186 522 330 562 374 C576 390 590 393 598 392' },
  { id: 't6', d: 'M780 392 C800 372 838 368 847 384 C852 393 852 400 852 404' },
  { id: 't5', d: 'M870 404 C870 200 850 82 800 75 C760 70 725 90 725 143' },
  { id: 't1', d: 'M655 143 C650 80 580 22 470 18 C300 10 55 120 55 310' },
];
const bubbles = [
  { x: 60, y: 488, r: 3, delay: 0 }, { x: 100, y: 492, r: 2, delay: 1.4 },
  { x: 228, y: 376, r: 2.5, delay: 0.6 }, { x: 262, y: 378, r: 2, delay: 2.1 },
  { x: 392, y: 480, r: 2.5, delay: 1.1 }, { x: 430, y: 482, r: 2, delay: 2.6 },
  { x: 640, y: 458, r: 3.5, delay: 0.3 }, { x: 700, y: 462, r: 2.5, delay: 1.8 }, { x: 752, y: 456, r: 3, delay: 1 },
];
const INDIGO = '#4B57B8';
---
<figure class="culnet" data-culnet>
  <svg class="cn" viewBox="0 0 910 540" role="img" aria-labelledby="cn-title" focusable="false">
    <title id="cn-title">The CulNet principle: four culture chambers, each holding a different tissue, linked by tubes so one circulating medium flows from chamber to chamber, through a large collection vessel and its reservoir, and back.</title>
    <defs>
      <linearGradient id="cn-medium" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#EDCDC2" />
        <stop offset="1" stop-color="#DDB3A7" />
      </linearGradient>
      <linearGradient id="cn-glass" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#DCE6FF" stop-opacity="0.75" />
        <stop offset="0.5" stop-color="#E9DEFF" stop-opacity="0.35" />
        <stop offset="1" stop-color="#F6DEFF" stop-opacity="0.7" />
      </linearGradient>
      {vessels.map((v) => (
        <clipPath id={`cn-clip-${v.id}`}><rect x={v.x} y={v.lid + v.lidH} width={v.w} height={v.body} rx="6" /></clipPath>
      ))}
    </defs>

    <!-- Tubes: an indigo outline, a rose tube, and white beads of medium that flow. -->
    <g class="cn__tubes" fill="none" stroke-linecap="round">
      {tubes.map((t) => (
        <g class="cn__tube" data-tube={t.id}>
          <path class="cn__tube-line" d={t.d} stroke={INDIGO} stroke-width="9" pathLength="1" />
          <path class="cn__tube-line" d={t.d} stroke="#DDB3A7" stroke-width="6.5" pathLength="1" />
          <path class="cn__bead" d={t.d} stroke="#FFFFFF" stroke-width="3.6" />
        </g>
      ))}
    </g>

    {vessels.map((v, i) => {
      const top = v.lid + v.lidH;
      const bottom = top + v.body;
      const surface = top + v.body * (1 - v.level);
      return (
        <g class="cn__vessel" data-vessel={v.id} style={`--i:${i}`}>
          {v.ports.map((px) => (
            <rect x={px - 9} y={v.lid - v.portH + 2} width="18" height={v.portH} rx="3" fill="#F5E3D9" stroke={INDIGO} stroke-width="1.25" />
          ))}
          <!-- Glass body, medium, inner pipes -->
          <rect x={v.x} y={top} width={v.w} height={v.body} rx="6" fill="url(#cn-glass)" />
          <g clip-path={`url(#cn-clip-${v.id})`}>
            <path class="cn__wave" d={wave(v.x, v.w, surface)} fill="url(#cn-medium)" opacity="0.9" style={`--d:${2.6 + i * 0.35}s`} />
            {bubbles.filter((b) => b.x > v.x && b.x < v.x + v.w).map((b) => (
              <circle class="cn__bubble" cx={b.x} cy={b.y} r={b.r} fill="#FFFFFF" opacity="0.8" style={`--delay:${b.delay}s;--rise:${-(b.y - surface - 6)}px`} />
            ))}
          </g>
          {v.ports.map((px) => (
            <line x1={px} y1={top} x2={px} y2={top + v.body * 0.5} stroke={INDIGO} stroke-width="5" stroke-opacity="0.18" stroke-linecap="round" />
          ))}
          <rect x={v.x} y={top} width={v.w} height={v.body} rx="6" fill="none" stroke={INDIGO} stroke-width="1.5" />
          <!-- Lid -->
          {v.id === 'd' ? (
            <>
              <rect x={v.x - 8} y={v.lid + 18} width={v.w + 16} height={v.lidH - 18} rx="8" fill="#FFFFFF" stroke={INDIGO} stroke-width="1.5" />
              <rect x={v.x + 10} y={v.lid} width={v.w - 20} height="24" rx="7" fill="#FAF1EC" stroke={INDIGO} stroke-width="1.5" />
            </>
          ) : (
            <rect x={v.x - 7} y={v.lid} width={v.w + 14} height={v.lidH} rx="6" fill="#FFFFFF" stroke={INDIGO} stroke-width="1.5" />
          )}
          <!-- Stage and base -->
          <ellipse cx={v.x + v.w / 2} cy={bottom - 12} rx={v.w / 2 - 8} ry={v.id === 'd' ? 16 : 9} fill="none" stroke={INDIGO} stroke-width="1" stroke-opacity="0.5" />
          <rect x={v.x - 8} y={bottom} width={v.w + 16} height={v.id === 'd' ? 46 : 22} rx="6" fill="#F5E3D9" stroke={INDIGO} stroke-width="1.5" />
        </g>
      );
    })}

    <!-- Tissues, one per chamber -->
    <g class="cn__tissues">
      <g class="cn__tissue" style="--delay:0s">
        <ellipse cx="73" cy="446" rx="20" ry="17" fill="#FAF1EC" stroke="#85484D" stroke-width="1.5" />
        <circle cx="71" cy="447" r="7" fill="#DDB3A7" />
      </g>
      <path class="cn__tissue" style="--delay:0.8s" d="M206 352 C222 330 252 322 274 326 C266 346 240 362 206 352 Z" fill="#85484D" opacity="0.85" />
      <path class="cn__tissue" style="--delay:1.6s" d="M384 462 C386 446 404 440 420 446 C432 452 428 468 412 470 C398 472 383 472 384 462 Z" fill="#DDB3A7" stroke="#85484D" stroke-width="1.25" />
      <path class="cn__tissue" style="--delay:2.4s" d="M630 404 C636 386 676 382 706 386 C734 384 760 382 762 396 C764 410 742 414 722 418 C706 432 690 452 664 452 C640 452 626 428 630 404 Z" fill="#85484D" opacity="0.9" />
    </g>

    <!-- Reservoir -->
    <g class="cn__vessel" data-vessel="e" style="--i:4">
      <rect x="843" y="396" width="18" height="14" rx="3" fill="#F5E3D9" stroke={INDIGO} stroke-width="1.25" />
      <rect x="861" y="396" width="18" height="14" rx="3" fill="#F5E3D9" stroke={INDIGO} stroke-width="1.25" />
      <rect x="836" y="410" width="52" height="88" rx="6" fill="#FFFFFF" stroke={INDIGO} stroke-width="1.5" />
      <rect x="836" y="410" width="52" height="12" rx="6" fill="#FAF1EC" stroke={INDIGO} stroke-width="1.5" />
    </g>
  </svg>
  <span class="label culnet__tag" aria-hidden="true">ONE CIRCULATING MEDIUM</span>
  <figcaption class="figcap">
    <span class="label">FIGURE 3</span>
    <span class="italic-line">The CulNet principle. Adapted from an illustration by IntegriCulture Inc.</span>
  </figcaption>
</figure>

<style>
  .culnet {
    position: relative;
    margin-top: clamp(72px, 8vw, 128px);
    padding: clamp(20px, 4vw, 64px) clamp(12px, 4vw, 64px) clamp(20px, 3vw, 40px);
    background: var(--shell-light);
    border-radius: var(--radius-card);
  }
  .cn { width: 100%; height: auto; overflow: visible; }
  .culnet__tag { position: absolute; left: 50%; top: clamp(8px, 2.4vw, 36px); transform: translateX(-50%); white-space: nowrap; }
  .figcap { margin-top: clamp(16px, 2vw, 28px); }

  /* Mobile: run edge to edge so the drawing keeps some size. */
  @media (max-width: 639px) {
    .culnet { margin-inline: calc(var(--pad) * -1); border-radius: 0; }
    .figcap { padding-inline: var(--pad); }
  }

  /* Motion (only when allowed). Loops pause while offscreen. */
  :global(.motion) .cn__bead { stroke-dasharray: 0.1 26; animation: cn-flow 1.1s linear infinite; }
  @keyframes cn-flow { to { stroke-dashoffset: -26.1; } }
  :global(.motion) .cn__wave { animation: cn-wave var(--d, 3s) linear infinite; }
  @keyframes cn-wave { to { transform: translateX(40px); } }
  :global(.motion) .cn__tissue {
    transform-box: fill-box;
    transform-origin: center;
    animation: cn-breathe 4.2s ease-in-out infinite alternate;
    animation-delay: var(--delay);
  }
  @keyframes cn-breathe { to { transform: scale(1.06); } }
  :global(.motion) .cn__bubble { animation: cn-rise 3.6s ease-in infinite; animation-delay: var(--delay); }
  @keyframes cn-rise {
    0% { transform: translateY(0); opacity: 0; }
    15% { opacity: 0.8; }
    100% { transform: translateY(var(--rise)); opacity: 0; }
  }
  .culnet:not(.is-playing) :global(*) { animation-play-state: paused !important; }
  /* Without motion, beads read as a dotted medium line. */
  .cn__bead { stroke-dasharray: 0.1 26; }
</style>
