---
import SectionFrame from './SectionFrame.astro';
import SplitReveal from './SplitReveal.astro';
import Spark from './Spark.astro';

const stats = [
  { n: '2', label: 'provisional patents filed, on composition and process' },
  { n: '3', label: 'university validation partners lined up' },
  { n: '10', label: 'signed letters of intent from biotech teams and clinics' },
];
---
<section class="section proof" aria-labelledby="proof-title">
  <SectionFrame label="06 / PROGRESS" />
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Where we are today</p>
      <SplitReveal id="proof-title" text="Pre-prototype, and already *backed*." />
    </div>
    <ul class="stats" role="list">
      {stats.map((s) => (
        <li class="stat" data-fade>
          <span class="stat__n" data-count={s.n}>{s.n}</span>
          <span class="stat__label">{s.label}</span>
        </li>
      ))}
    </ul>
    <p class="strip card" data-fade>
      <Spark size={16} />
      <span>Winner, startup pitch competition, International Longevity Summit Madrid 2026 · CRRATE Capital Readiness Award</span>
    </p>
  </div>
</section>

<style>
  .stats { display: grid; gap: 40px; }
  .stat { display: grid; gap: 12px; padding-top: 24px; border-top: 1px solid var(--hairline); }
  .stat__n { font-family: var(--font-display); font-size: clamp(4.5rem, 3rem + 4vw, 6rem); line-height: 1; color: var(--ink); font-feature-settings: "lnum"; }
  .stat__label { max-width: 28ch; color: var(--ink-soft); }
  .strip { margin-top: 56px; display: flex; gap: 16px; align-items: center; padding: 22px 26px; color: var(--ink); font-weight: 500; font-size: 16px; }
  @media (min-width: 960px) {
    .stats { grid-template-columns: repeat(3, 1fr); gap: var(--gutter); }
  }
</style>
