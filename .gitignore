# Generated from fda.html by `npm run build` — never hand-edited, so not tracked.
# (mobile/www/fonts/fonts.css IS tracked: it is a vendored binary payload that
#  needs network access to regenerate.)
mobile/www/index.html

# Signing material must never be committed
*.apk
*.aab
*.keystore
*.jks
mobile/android/keystore.properties
mobile/native/build/
